{
  "color": {
    "$type": "color",
    "primary": { "$value": "#3B82F6" },
    "accent": { "$value": "#F59E0B", "$description": "Amber accent" },
    "brand": { "$value": "{color.primary}" }
  },
  "space": {
    "$type": "dimension",
    "sm": { "$value": "0.5rem" },
    "md": { "$value": { "value": 16, "unit": "px" } }
  },
  "misc": {
    "shadow": { "$value": "0 1px 2px rgba(0, 0, 0, 0.1)" },
    "untyped-color": { "$value": "#10B981" }
  },
  "broken": {
    "loop-a": { "$value": "{broken.loop-b}" },
    "loop-b": { "$value": "{broken.loop-a}" }
  }
}
